# Environment variables for Mizan Backend API
# Copy to .env for development:
#   cp .env.example .env

# Database URL (PostgreSQL in production, SQLite for local dev)
# Local development (default):
DATABASE_URL=sqlite:///./mizan.db

# Production (PostgreSQL on Render):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT Secret Key — MUST be a strong random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Local development (default):
JWT_SECRET_KEY=dev-secret-key-CHANGE-IN-PRODUCTION-abc123

# Production:
# JWT_SECRET_KEY=<your-strong-random-secret-here>

# Port (Render sets this automatically)
PORT=8000
