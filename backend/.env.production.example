# ════════════════════════════════════════════════════════════════════════════
# Mizan — Production Environment Variables Template
# Copy to .env.production and fill in real values.
#
#   cp .env.production.example .env.production
#
# IMPORTANT: Never commit .env.production to git.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
# Must be "production" in prod. Enables fail-closed security guards.
APP_ENV=production

# Server port (Render sets this automatically; for Docker it's 8000)
PORT=8000

# Number of Gunicorn workers (default: 2). Rule of thumb: (2 × CPU cores) + 1
WEB_CONCURRENCY=2

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string — get this from your managed Postgres provider
# (Render, Supabase, RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/mizan

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing key — MUST be 32+ chars random hex.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: The app refuses to start if this is missing/weak in production.
JWT_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Additional origins (optional)
ALLOWED_ORIGINS=https://mizan-invest.vercel.app

# ── Email (Password Reset) ───────────────────────────────────────────────
# SMTP settings for transactional emails (password reset, etc.)
# Any SMTP provider works: SendGrid, AWS SES, Mailgun, Postmark, etc.
# If not set, emails are printed to the server console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# The "from" address for outgoing emails
FROM_EMAIL=noreply@mizan.app

# Frontend base URL — used to build password reset links
APP_BASE_URL=https://your-domain.com
