# ── AI Research Engine (OpenRouter) ─────────────────────────────────────────
# Required: OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
# Optional: Base URL override (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: Model override (default: deepseek/deepseek-chat = DeepSeek V3)
# Alternatives to experiment with:
#   deepseek/deepseek-chat      — DeepSeek V3 (default, strong value analysis)
#   deepseek/deepseek-r1        — DeepSeek R1 (reasoning-focused)
#   zhipuai/glm-4.5             — GLM latest
RESEARCH_MODEL=deepseek/deepseek-chat

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# All optional in development (billing endpoints return 503 if not set)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
FRONTEND_URL=http://localhost:3000

# ── Existing ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./mizan.db
JWT_SECRET_KEY=change-this-to-a-random-32-char-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_ENV=development
