[Unit]
Description=Cloudflare Tunnel for Mizan (mizan-invest.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --config /home/enigma/kinox/projects/bank/ai-berkshire/cloudflared/config.yml run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
